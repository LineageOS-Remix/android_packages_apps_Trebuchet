<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/hotseat_qsb_inner"
        android:layout_width="match_parent"
        android:layout_height="@dimen/qsb_widget_height"
        android:layout_gravity="center"
        android:background="@drawable/bg_pixel_qsb"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/qsb_g_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical"
            android:src="@drawable/ic_google_color"
            android:contentDescription="@string/all_apps_search_bar_hint" />

        <TextView
            android:id="@+id/btn_qsb_search"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:singleLine="true"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFamily="google-sans-text-medium"
            android:text="@string/all_apps_search_bar_hint"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="15sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground" />

        <ImageView
            android:id="@+id/qsb_mic_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_google_mic_color"
            android:contentDescription="@string/action_listen"
            android:background="?android:attr/selectableItemBackgroundBorderless" />

        <ImageView
            android:id="@+id/qsb_lens_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical"
            android:src="@drawable/ic_google_lens_color"
            android:contentDescription="@string/action_translate"
            android:background="?android:attr/selectableItemBackgroundBorderless" />

        <ImageView
            android:id="@+id/btn_qsb_setup"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical"
            android:clickable="true"
            android:visibility="gone"
            android:src="@drawable/ic_setting"
            android:tint="?android:attr/textColorSecondary"
            android:contentDescription="@string/gadget_setup_text"
            android:padding="8dp"
            android:background="?android:attr/selectableItemBackground" />
    </LinearLayout>
</FrameLayout>
