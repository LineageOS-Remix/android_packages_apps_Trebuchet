<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|start"
        android:orientation="vertical">

        <!-- Pixel At A Glance Date -->
        <TextClock
            android:id="@+id/smartspace_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="EEEE, MMM d"
            android:format24Hour="EEEE, MMM d"
            android:fontFamily="google-sans-text-medium"
            android:textSize="22sp"
            android:textColor="?android:attr/textColorPrimary"
            android:shadowColor="#40000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btn_qsb_search"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/all_apps_search_bar_hint"
                android:fontFamily="google-sans"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorSecondary"
                android:shadowColor="#30000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground" />

            <ImageView
                android:id="@+id/btn_qsb_setup"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:clickable="true"
                android:visibility="gone"
                android:src="@drawable/ic_setting"
                android:tint="?android:attr/textColorSecondary"
                android:contentDescription="@string/gadget_setup_text"
                android:background="?android:attr/selectableItemBackground" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
